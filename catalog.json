{
  "manga": [{% for entry in site.data.manga %}{
    "slug": {{ entry[0] | jsonify }},
    "data": {{ entry[1] | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "volumes": [{% for entry in site.data.volumes %}{
    "id": {{ entry[0] | jsonify }},
    "data": {{ entry[1] | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "anime": [{% for entry in site.data.anime %}{
    "slug": {{ entry[0] | jsonify }},
    "data": {{ entry[1] | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "episodes": [{% for entry in site.data.episodes %}{
    "id": {{ entry[0] | jsonify }},
    "data": {{ entry[1] | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "music": [{% for entry in site.data.music %}{
    "id": {{ entry[0] | jsonify }},
    "data": {{ entry[1] | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "mv": [{% for entry in site.data.mv %}{
    "id": {{ entry[0] | jsonify }},
    "data": {{ entry[1] | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "articles": [{% for entry in site.data.articles %}{
    "slug": {{ entry[0] | jsonify }},
    "data": {{ entry[1] | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}]
}
